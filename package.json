{
  "name": "@tinyforge/dsh-skills-wj",
  "version": "1.2.4",
  "description": "WJ 武库（dsh-skills-wj）：版本化的 DeepSeek Harness skill 合集，把本包的 skills/ 挂载为 bundled skill root，并在 host 层启用 skill loader。",
  "license": "MIT",
  "icon": "./icon.webp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixlucky/dsh-skills-wj.git"
  },
  "homepage": "https://github.com/phoenixlucky/dsh-skills-wj#readme",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./skills/*": "./skills/*"
  },
  "files": [
    "cordis.patch.yml",
    "icon.webp",
    "locale/*.json",
    "skills",
    "README.md"
  ],
  "scripts": {
    "check:skills": "node scripts/check-skills.mjs",
    "prepublishOnly": "node scripts/check-skills.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-skill": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-skill": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
