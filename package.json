{
  "name": "@tinyforge/dsh-skills-wj",
  "version": "1.0.0",
  "description": "Versioned DeepSeek Harness skill root: mounts this package's skills/ directory as a bundled skill root and enables the skill loader at the host plane.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixlucky/dsh-skills-wj.git"
  },
  "homepage": "https://github.com/phoenixlucky/dsh-skills-wj#readme",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "files": [
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-skill": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": { "optional": true },
    "@deepseek-ai/dsh-tool-skill": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
